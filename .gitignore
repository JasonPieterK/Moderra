# Build output. The build scripts copy the finished jars into 1-download-jars/; they are published on GitHub Releases, not in git.
1-download-jars/*.jar
target/
build/
.gradle/
build-logs/

# Test servers started by the test scripts (worlds, logs, downloaded libraries)
run/
run-*/

# Node packages of the scripted test player (5-shared-engine/live-player-test)
node_modules/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Java packages named "build" inside source folders are source code, not build output
!**/src/**/build/
