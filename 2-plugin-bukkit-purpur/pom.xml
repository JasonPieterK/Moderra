<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jason.plugins</groupId>
    <artifactId>antibadwords</artifactId>
    <version>1</version>
    <packaging>jar</packaging>

    <name>AntiBadWords</name>
    <description>Advanced profanity blocking with punishments and admin tools.</description>

    <url>https://github.com/JasonPieterK/AntiBadWordsPlugin</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            One source tree, one jar per Minecraft release. These four properties are overridden per
            version by build-all-versions.sh (see MINECRAFT_VERSIONS there); the defaults build the oldest
            supported release.
              mc.version          Minecraft release the jar is built for (used in the file name)
              mc.api.version      value written to "api-version" in plugin.yml
              spigot.api.version  Spigot API to compile against (only Bukkit/Spigot API is used, so the
                                  jar runs on Spigot and Paper)
              java.release       Java language level (Minecraft 26.x requires Java 25)
        -->
        <!-- Loader name used in the jar file name: Antibadwords-RELEASE[Bukkit] - 1-<mc.version>.jar -->
        <loader.name>Bukkit</loader.name>
        <mc.version>1.21.11</mc.version>
        <mc.api.version>1.21</mc.api.version>
        <spigot.api.version>1.21.11-R0.1-SNAPSHOT</spigot.api.version>
        <java.release>21</java.release>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The engine reads YAML with SnakeYAML. Every Bukkit server ships it (spigot-api depends on it), so it is only
             needed for compiling and is not put into the jar. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Antibadwords-RELEASE[${loader.name}] - ${project.version}-${mc.version}</finalName>
        <resources>
            <!-- plugin.yml needs ${project.version} / ${mc.api.version}. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <!-- The shared engine's own files (default punishment sections, word-list index); never filtered. -->
            <resource>
                <directory>../5-shared-engine/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- The word lists (data source of truth: 7-wordlists/) go into the jar as wordlists/<code>.yml. -->
            <resource>
                <directory>../7-wordlists</directory>
                <targetPath>wordlists</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.yml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- The platform-neutral engine is compiled into the plugin jar as a second source folder (no separate jar). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-engine-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration><sources><source>../5-shared-engine/src/main/java</source></sources></configuration>
                    </execution>
                    <!-- Two empty-ish DiscordSRV class names (Subscribe, the pre-process event) so DiscordSrvListener compiles without DiscordSRV's
                         repository. They are NOT packaged (see maven-jar-plugin below): at runtime DiscordSRV's own classes are used. -->
                    <execution>
                        <id>add-discordsrv-shim</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration><sources><source>src/discordsrv-shim/java</source></sources></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-deprecation</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <excludes>
                        <exclude>github/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
