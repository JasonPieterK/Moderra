  "messages": {
    "broadcast-warnings": true,
    "warning-broadcast-format": "&C{PLAYER} SAID THE WORD &F{WORD}&C WHICH IS NOT ALLOWED.",
    "warning-player": "&EWATCH YOUR WORDS. YOU ARE PUNISHED IF YOU SAY &F{REMAINING}&E BADWORDS AGAIN.",
    "punishment-broadcast-format": "&C{PLAYER} SAID THE WORD &F{WORD}&C WHICH IS NOT ALLOWED. FOR THEIR ACTION THEY'LL BE PUNISHED WITH &F{PUNISHMENTS}&C.",
    "punishment-player": "&CFOR YOUR BADWORDS, YOU ARE PUNISHED WITH &F{PUNISHMENTS}&C.",
    "punishment-disabled-player": "&EYOUR MESSAGE WAS BLOCKED. PUNISHMENT IS CURRENTLY DISABLED.",
    "notify-staff": true,
    "staff-notify-format": "&8[&cAntiBadWords&8] &7Blocked '&f{word}&7' from &f{player}&7 in &f{source}&7 (&f{count}&7/&f{limit}&7)."
  },
  "punishment": {
    "enabled": true,
    "violations-before-punish": 2,
    "clear-violations-on-quit": true,
    "final-command": "",
