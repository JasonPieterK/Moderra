<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.jason.plugins</groupId>
    <artifactId>antibadwords-mod-core</artifactId>
    <version>1</version>
    <packaging>jar</packaging>
    <name>AntiBadWords mod core</name>
    <description>Loader-independent logic shared by the Fabric and Forge mods. Used for tests; the mods compile the same sources.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- The mods ship the plugin's own config.yml, so both read exactly the same file. -->
            <resource>
                <directory>../2-plugin-bukkit-purpur/src/main/resources</directory>
                <includes><include>config.yml</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-bukkit-free-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration><sources><source>../2-plugin-bukkit-purpur/src/main/java</source></sources></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Only the plugin classes that do not touch Bukkit are shared. -->
                    <includes>
                        <include>**/mod/*.java</include>
                        <include>**/WordMatcher.java</include>
                        <include>**/Placeholders.java</include>
                        <include>**/PunishmentAction.java</include>
                        <include>**/AntiBadWordsSettings.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
